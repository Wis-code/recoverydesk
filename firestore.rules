rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function bootstrapAdmin() {
      return signedIn() && request.auth.uid == "NkBCSA8109gLUz0lwrlvVU2Q02H3";
    }

    function hasAccess() {
      return signedIn() &&
        exists(/databases/$(database)/documents/access/$(request.auth.uid));
    }

    function isAdmin() {
      return bootstrapAdmin() ||
        (hasAccess() &&
         get(/databases/$(database)/documents/access/$(request.auth.uid)).data.active == true &&
         get(/databases/$(database)/documents/access/$(request.auth.uid)).data.role in ["owner", "admin", "subadmin"]);
    }

    function isOps() {
      return bootstrapAdmin() ||
        (hasAccess() &&
         get(/databases/$(database)/documents/access/$(request.auth.uid)).data.active == true &&
         get(/databases/$(database)/documents/access/$(request.auth.uid)).data.role in ["owner", "admin", "subadmin", "worker"]);
    }

    match /access/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    match /customerAccess/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isOps());
      allow create, update, delete: if isOps();
    }
  }
}
